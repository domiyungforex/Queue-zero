NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://turnmark.conchportal.com. No path, query, fragment, or credentials.
# Required for business authentication. Use test keys for local development.
# Set NEXT_PUBLIC_APP_URL to the exact browser origin (including its port).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production custom domain uses the direct Clerk frontend API.
CLERK_DISABLE_AUTO_PROXY=true
# Optional issuer-signed role template when sharing an existing Clerk instance.
CLERK_DATABASE_JWT_TEMPLATE=
# Reserved for the later Clerk webhook integration.
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
# Accepts a new sb_publishable_ key or a legacy anon JWT. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for the controlled anonymous join mutation. Server only.
# Public queue landing reads use the anon key and a narrow RPC, not this key.
# The current authenticated database client does not use this key.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# PostHog browser analytics. Use the project token and ingestion host from PostHog settings.
# Example host: https://us.i.posthog.com (use your project's region-specific host).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Required for anonymous joining: generate with openssl rand -hex 32. Server only.
QUEUE_JOIN_SECRET=

# Paid plans must exist in Paystack; amounts/currency are verified against these plans.
PAYSTACK_STARTER_PLAN_CODE=
PAYSTACK_BUSINESS_PLAN_CODE=
PAYSTACK_CURRENCY=NGN

# Stripe billing configuration (server-only secret & webhook secret).
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_DEFAULT_PROVIDER=paystack
PAYMENT_MODE=test
# Protects scheduled notification retries; generate a random value.
CRON_SECRET=

# Optional separate server-only attendance signing secret (32+ characters).
# Falls back to a domain-separated key derived from QUEUE_JOIN_SECRET.
ATTENDANCE_QR_SECRET=
# Enable only after phone OTP is configured in Clerk. Email OTP is the default.
NEXT_PUBLIC_CLERK_PHONE_AUTH_ENABLED=false

# Private Cloudflare R2 bucket for student and attendance photographs.
# Leave blank to keep using the private Supabase attendance-photos bucket.
# Never put these values in NEXT_PUBLIC_ variables or client code.
# R2_ENDPOINT defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

