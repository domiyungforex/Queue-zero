{
  "crons": [{ "path": "/api/notifications/deliver", "schedule": "0 0 * * *" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/ticket/:path*", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/attend/:path*", "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self)" }] },
    { "source": "/attend", "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self)" }] },
    { "source": "/:path*", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "X-Frame-Options", "value": "DENY" }, { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self)" }] }
  ]
}
